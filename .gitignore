# NeuroMetric / BrainAge — what stays out of the repository
# Large data, model weights, virtualenvs and build outputs are not committed;
# the catalogue and prepare steps regenerate them.

# --- Python environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# --- Data and model artifacts (gigabytes; regenerate via catalogue + prepare)
.cache/
data/*
!data/dkt_lobe_groups.json
artifacts/
*.nii
*.nii.gz
*.npz
*.npy
*.pt
*.pth
*.p
*.ckpt

# --- Secrets / personal Kaggle session
.kaggle/
kaggle.json
.env
*.pem
*.key

# --- Site build output and personal backups
dist-demo/
backups/

# --- OS / editor
.DS_Store
Thumbs.db
*.swp
*.bak
.vercel
.env*
